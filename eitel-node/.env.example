# EITEL Node Handshake Service Configuration

# === Node Identity ===
# Directory for persisting this node's Ed25519 keypair and derived did:key
# Must be a Docker volume or bind mount in production
EITEL_NODE_NODE_IDENTITY_DIR=/identity

# === Coordinator Trust Anchor ===
# Path to EITELCoordinator's Ed25519 public key (JWK format)
# This is the static trust anchor — coordinator key is loaded once at startup
# No live DID resolution; key rotation requires service restart
EITEL_NODE_COORDINATOR_PUBKEY_JWK_PATH=/keys/coordinator_pubkey.jwk

# === EDC Integration ===
# EDC management API base URL
# For PoC with Option B: set to external EDC deployment URL
# For PoC with Option A (include caas/): set to http://eitel-caas-control-plane:8081
EITEL_NODE_EDC_MANAGEMENT_URL=http://edc-control:8182

# EDC management API authentication key (x-api-key header)
EITEL_NODE_EDC_API_KEY=change-me

# EDC DSP endpoint URL (returned to peer in handshake response for DSP negotiation)
# This is the internal or external URL peer should use to reach this node's EDC
EITEL_NODE_EDC_DSP_ENDPOINT=http://localhost:11003/api/v1/dsp

# === Session Tokens ===
# Session token time-to-live (seconds)
# Default: 3600 (1 hour)
EITEL_NODE_SESSION_TOKEN_TTL=3600

# Session token signing secret (HMAC-SHA256)
# REQUIRED — must be set to a strong random value
# Generate: openssl rand -base64 32
# DO NOT use weak values like "change-me" in production
EITEL_NODE_SESSION_TOKEN_SECRET=change-me-generate-strong-random-value-here

# === Server ===
# Bind address (0.0.0.0 = all interfaces)
# In production: bind to localhost and put behind TLS reverse proxy
EITEL_NODE_HOST=0.0.0.0

# Server port
EITEL_NODE_PORT=8080
